<?xml version="1.0" encoding="UTF-8"?>
<!-- SCENARIO 3: HEAVY DEMAND - frequent lane changes, speed reductions -->
<routes>
    <route id="WB_route" edges="-1 -2 21 20 19 18 5"/>
    <route id="EB_route" edges="-5 -18 -19 -20 -21 2 1"/>

    <flow id="WB_car"
          type="car" route="WB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_WB_60"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="WB_slow"
          type="car_slow" route="WB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_WB_25"
          departLane="first" departSpeed="0" arrivalSpeed="current"/>

    <flow id="WB_aggressive"
          type="car_aggressive" route="WB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_WB_15"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="EB_car"
          type="car" route="EB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_EB_60"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="EB_slow"
          type="car_slow" route="EB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_EB_25"
          departLane="first" departSpeed="0" arrivalSpeed="current"/>

    <flow id="EB_aggressive"
          type="car_aggressive" route="EB_route"
          begin="0" end="3600" vehsPerHour="DENSITY_EB_15"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>
</routes>
