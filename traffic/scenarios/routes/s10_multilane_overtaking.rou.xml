<?xml version="1.0" encoding="UTF-8"?>
<!-- SCENARIO 10: SIMULTANEOUS MULTI-LANE OVERTAKING -->
<routes>
    <route id="WB_route" edges="-1 -2 21 20 19 18 5"/>
    <route id="EB_route" edges="-5 -18 -19 -20 -21 2 1"/>

    <flow id="WB_slow_wave"
          type="car_slow" route="WB_route"
          begin="0" end="3600" period="8"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="WB_fast_wave"
          type="car_aggressive" route="WB_route"
          begin="20" end="3600" period="6"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="EB_slow_wave"
          type="car_slow" route="EB_route"
          begin="0" end="3600" period="8"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>

    <flow id="EB_fast_wave"
          type="car_aggressive" route="EB_route"
          begin="20" end="3600" period="6"
          departLane="random" departSpeed="0" arrivalSpeed="current"/>
</routes>
