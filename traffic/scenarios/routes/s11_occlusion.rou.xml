<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCENARIO 11: OCCLUSION
    Large trucks in the curb lane hide cars in the inner lane from the
    infrastructure sensors. OcclusionController in runner.py matches each
    car's speed to its paired truck while they are on edge 20 / -20 so the
    pair travels side by side.

    Pair ids are wb / eb. The controller previously looked for nb / sb and
    therefore never matched anything; scenario 11 produced ordinary traffic.

    departLane FIX: trucks used departLane="0" (the SIDEWALK) and cars
    departLane="1" (a disallow="all" shoulder). Lane 3 = curb driving lane,
    lane 4 = inner driving lane. The flows previously used departLane="last",
    which SUMO does not accept at all ("must be one of random, free, allowed,
    best, best_prob, first, or an int>=0"), so the inner-car flows never
    departed either. Both flows and vehicles now name lanes 3 and 4 explicitly.
-->
<routes>
    <route id="WB_route" edges="-1 -2 21 20 19 18 5"/>
    <route id="EB_route" edges="-5 -18 -19 -20 -21 2 1"/>

    <!-- Named pairs only. Unpaired truck/car flows saturated the single-lane
         westbound entry and were not kept beside a partner. -->

    <vehicle id="occ_pair_wb_truck_1" type="truck_large" route="WB_route" depart="15"  departLane="3" departSpeed="0" color="0.2,0.2,0.2"/>
    <vehicle id="occ_pair_wb_car_1"   type="car"         route="WB_route" depart="15"  departLane="4" departSpeed="0" color="1,1,0"/>
    <vehicle id="occ_pair_wb_truck_2" type="truck_large" route="WB_route" depart="90"  departLane="3" departSpeed="0" color="0.2,0.2,0.2"/>
    <vehicle id="occ_pair_wb_car_2"   type="car"         route="WB_route" depart="90"  departLane="4" departSpeed="0" color="1,1,0"/>

    <vehicle id="occ_pair_eb_truck_1" type="truck_large" route="EB_route" depart="15"  departLane="3" departSpeed="0" color="0.2,0.2,0.2"/>
    <vehicle id="occ_pair_eb_car_1"   type="car"         route="EB_route" depart="15"  departLane="4" departSpeed="0" color="1,1,0"/>
    <vehicle id="occ_pair_eb_truck_2" type="truck_large" route="EB_route" depart="90"  departLane="3" departSpeed="0" color="0.2,0.2,0.2"/>
    <vehicle id="occ_pair_eb_car_2"   type="car"         route="EB_route" depart="90"  departLane="4" departSpeed="0" color="1,1,0"/>
</routes>
